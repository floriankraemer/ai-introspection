# Copy to .env. Compose reads it automatically.
# Run containers as your host user so files in bind mounts are never owned by root.
# On Linux and WSL2 find your values with `id -u` and `id -g`.
UID=1000
GID=1000

# Everything below is optional.

# Your git identity for commits Introspect makes in your skills and project repositories.
# Leave unset to commit as "Introspect".
# GIT_AUTHOR_NAME=Ada Lovelace
# GIT_AUTHOR_EMAIL=ada@example.com
# GIT_COMMITTER_NAME=Ada Lovelace
# GIT_COMMITTER_EMAIL=ada@example.com

# Global skills repository, mounted read-write at /repos/skills (the wizard proposes that path).
# Point it at your existing skills repository (a git repository), or leave it unset: the default
# ~/.introspect/skills starts empty and the setup wizard can create a repository there for you.
# Do not point it at ~/.claude: that folder holds your Claude credentials and transcripts.
# INTROSPECT_SKILLS_REPO=/home/you/my-skills

# Folder that holds your project repositories, mounted read-write at /repos/projects.
# Default: ~/.introspect/projects (an empty folder).
# INTROSPECT_PROJECTS_DIR=/home/you/projects

# GitHub token, only needed for PR mode.
# GH_TOKEN=

# Your Claude login for the CLI judge ("Local claude CLI" in Settings), mounted read-only as one file.
# Default: ~/.claude/.credentials.json (log in with `claude login` on the host).
# INTROSPECT_CLAUDE_CREDENTIALS=/home/you/.claude/.credentials.json

# Test-only: grade with a deterministic fake judge instead of a model. Not reachable from the UI.
# INTROSPECT_JUDGE=fake
